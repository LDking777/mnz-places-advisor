{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DesplegarLambdas",
      "Effect": "Allow",
      "Action": [
        "lambda:UpdateFunctionCode",
        "lambda:PublishVersion",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration"
      ],
      "Resource": "arn:aws:lambda:<REGION>:<ACCOUNT_ID>:function:mnz-api-*"
    },
    {
      "Sid": "LanzarBuildsAmplify",
      "Effect": "Allow",
      "Action": [
        "amplify:StartJob",
        "amplify:GetJob"
      ],
      "Resource": "arn:aws:amplify:<REGION>:<ACCOUNT_ID>:apps/<AMPLIFY_APP_ID>/*"
    }
  ]
}
